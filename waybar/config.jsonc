{
	"layer": "top",
	"position": "top",

	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": [
		"pulseaudio",
		"backlight",
		"battery",
		"network",
		"power-profiles-daemon",
		"tray"
	],

	"hyprland/workspaces": {
		"format": "{name}: {icon}",
		"format-icons": {
			"active": "",
			"default": ""
		}
	},

	"tray": {
		"icon-size": 14,
		"spacing": 5
	},

	"battery": {
		"format": " {capacity}%",
		"tooltip": false
	},

	"backlight": {
		"device": "intel_backlight",
		"format": " {percent}%",
		"tooltip": false
	},

	"clock": {
		"timezone": "Uzbekistan/Tashkent",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%d/%m/%Y - %H:%M:%S}",
		"interval": 1
	},

	"network": {
		"format-wifi": " ",
		"format-ethernet": " ",
		"format-disconnected": " ",
		"interval": 5,
		"tooltip": false
	},

	"cpu": {
		"interval": 1,
		"format": " {usage:>2}%",
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
	},

	"memory": {
		"interval": 30,
		"format": " {used:0.1f}G"
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "",
		"format-icons": {
			"default": ["", "", " "]
		},
		"on-click": "pavucontrol"
	},

	"power-profiles-daemon": {
		"format": "{icon}",
		"tooltip-format": "Power profile: {profile}nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"default": "",
			"performance": "",
			"balanced": "",
			"power-saver": ""
		}
	},


	"custom/uptime": {
		"format": "{}",
		"interval": 1600,
		"exec": "awk '{printf \"%.0f h\", $1/3600}' /proc/uptime"
	}
}
