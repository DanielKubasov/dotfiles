{
	"layer": "top",
	"position": "top",
	"modules-left": ["hyprland/workspaces"],

	"modules-center": ["clock"],

	"modules-right": [
		"pulseaudio",
		"custom/uptime",
		"backlight",
		"battery",
		"power-profiles-daemon",
		"network",
		"cpu",
		"memory",
		"tray",
		"custom/lock"
	],

	"hyprland/workspaces": {
		"format": "{name}: {icon}",
		"format-icons": {
			"active": "",
			"default": ""
		}
	},

	"tray": {
		"icon-size": 16,
		"spacing": 5
	},

	"battery": {
		"format": " {capacity}%",
		"tooltip": false
	},

	"backlight": {
		"device": "intel_backlight",
		"format": " {percent}%",
		"tooltip": false
	},

	"custom/music": {
		"format": "  {}",
		"escape": true,
		"interval": 5,
		"tooltip": false,
		"exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
		"on-click": "playerctl play-pause",
		"max-length": 50
	},

	"clock": {
		"timezone": "Uzbekistan/Tashkent",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%d/%m/%Y - %H:%M:%S}",
		"interval": 1
	},

	"network": {
		"format-wifi": " ",
		"format-ethernet": " ",
		"format-disconnected": " ",
		"interval": 5,
		"tooltip": false
	},

	"cpu": {
		"interval": 1,
		"format": " {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
	},

	"memory": {
		"interval": 30,
		"format": " {used:0.1f}G"
	},

	"custom/uptime": {
		"format": "{}",
		"interval": 1600,
		"exec": "awk '{printf \"%.0f h\", $1/3600}' /proc/uptime"
	},


	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "",
		"format-icons": {
			"default": ["", "", " "]
		},
		"on-click": "pavucontrol"
	},

	"power-profiles-daemon": {
		"format": "{icon}",
		"tooltip-format": "Power profile: {profile}nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"default": "",
			"performance": "",
			"balanced": "",
			"power-saver": ""
		}
	},

	"custom/weather": {
		"format": "{}",
		"tooltip": true,
		"interval": 1800,
		"exec": "$(pwd)/scripts/weather-stats/weather-stats",
		"return-type": "json"
	}
}
